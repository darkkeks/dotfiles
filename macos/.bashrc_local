## PATH

# Source brew variables
# eval "$(/opt/homebrew/bin/brew shellenv)" (5-10ms)
export HOMEBREW_PREFIX="/opt/homebrew";
export HOMEBREW_CELLAR="/opt/homebrew/Cellar";
export HOMEBREW_REPOSITORY="/opt/homebrew";
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}";
export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:";
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}";

# Add yc to PATH
[[ -d ~/yandex-cloud/bin ]] && PATH="$HOME/yandex-cloud/bin:$PATH"

## ARC

# https://coolors.co/ffbe0b-fb5607-ff006e-8338ec-3a86ff-00ffff
ROOT_COLOR=(660000)
ARC_COLORS=(ffbe0b fb5607 ff006e 8338ec 3a86ff 00ffff)

alias r0="cd /arc; iterm-tab-colors ${ROOT_COLOR[0]}"
alias r1="cd ~/repo/a1/direct; iterm-tab-colors ${ARC_COLORS[0]}"
alias r2="cd ~/repo/a2/direct; iterm-tab-colors ${ARC_COLORS[1]}"
alias r3="cd ~/repo/a3/direct; iterm-tab-colors ${ARC_COLORS[2]}"
alias r4="cd ~/repo/a4/direct; iterm-tab-colors ${ARC_COLORS[3]}"
alias rt="cd ~/repo/at/direct; iterm-tab-colors ${ARC_COLORS[4]}"
alias rb="cd ~/repo/ab/direct; iterm-tab-colors ${ARC_COLORS[5]}"

function mount-all {
    arc mount -m /var/lib/arc/arcadia -S /var/lib/arc/store --object-store /var/lib/arc/object-store
    arc mount -m ~/repo/a1 -S ~/repo/s1 --object-store /var/lib/arc/object-store
    arc mount -m ~/repo/a2 -S ~/repo/s2 --object-store /var/lib/arc/object-store
    arc mount -m ~/repo/a3 -S ~/repo/s3 --object-store /var/lib/arc/object-store
    arc mount -m ~/repo/a4 -S ~/repo/s4 --object-store /var/lib/arc/object-store
    arc mount -m ~/repo/at -S ~/repo/st --object-store /var/lib/arc/object-store
    arc mount -m ~/repo/ab -S ~/repo/sb --object-store /var/lib/arc/object-store
}

## SSH

function colored-ssh {
    color=$1; shift
    [[ -z $color ]] || iterm-tab-colors $color
    ssh $@
    [[ -z $color ]] || iterm-tab-colors
}

## OTHER

# Shortcut for local dbs-sql
function m {
    if [[ " $@ " =~ " -q " ]] || [[ ! -t 0 ]]; then
        # no need for a tty
        ssh dev "ya tool direct sql $(printf "%q " "$@")";
    else
        ssh -t dev "ya tool direct sql $(printf "%q " "$@")";
    fi
}

function doi {
    printf "%s\0" "$@" | ssh tdev '
        [[ -f .arc/token ]] || arc token store
        [[ -f arcadia/.arcadia.root ]] || arc mount
        xargs -0 ./arcadia/direct/perl/bin/object-info | format-direct-log --colored
    '
}

# Ya tools
alias cs="ya-tool cs"
alias direct="ya-tool direct"
alias dnsclient="ya-tool dnsclient"
alias grut="ya-tool grut"
alias infractl="ya-tool infractl"
alias kubectl="ya-tool kubectl"
alias logbroker="ya-tool logbroker"
alias tofu="ya-tool tofu"
alias yo="ya-tool yo"
alias yp="ya-tool yp"
alias yt="ya-tool yt"
