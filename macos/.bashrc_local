## PATH

# Source brew variables
# eval "$(/opt/homebrew/bin/brew shellenv)" (5-10ms)
export HOMEBREW_PREFIX="/opt/homebrew";
export HOMEBREW_CELLAR="/opt/homebrew/Cellar";
export HOMEBREW_REPOSITORY="/opt/homebrew";
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}";
export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:";
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}";

# Add yc to PATH
[[ -d ~/yandex-cloud/bin ]] && PATH="$HOME/yandex-cloud/bin:$PATH"
if [ -f ~/ycp/path.bash.inc ]; then source ~/ycp/path.bash.inc; fi
if [ -f ~/ycp/completion.bash.inc ]; then source ~/ycp/completion.bash.inc; fi

# # The next line updates PATH for Yandex Cloud Private CLI.
# if [ -f '/Users/darkkeks/ycp/path.bash.inc' ]; then source '/Users/darkkeks/ycp/path.bash.inc'; fi
# 
# # The next line enables shell command completion for ycp.
# if [ -f '/Users/darkkeks/ycp/completion.bash.inc' ]; then source '/Users/darkkeks/ycp/completion.bash.inc'; fi


## ARC

# https://coolors.co/660000-ffbe0b-fb5607-ff006e-8338ec-3a86ff-00ffff
ARC_COLORS=(660000 ffbe0b fb5607 ff006e 8338ec 3a86ff 00ffff)

alias r0="cd /arc;         iterm-tab-colors ${ARC_COLORS[0]}"
alias r1="cd ~/a/1/dikidi; iterm-tab-colors ${ARC_COLORS[1]}"
alias r2="cd ~/a/2/dikidi; iterm-tab-colors ${ARC_COLORS[2]}"
alias r3="cd ~/a/3/dikidi; iterm-tab-colors ${ARC_COLORS[3]}"
alias r4="cd ~/a/4/dikidi; iterm-tab-colors ${ARC_COLORS[4]}"

function mount-all {
    arc mount -m /var/lib/arc/arcadia -S /var/lib/arc/store --object-store /var/lib/arc/object-store
    arc mount -m ~/a/1 -S ~/a/s/1 --object-store /var/lib/arc/object-store
    arc mount -m ~/a/2 -S ~/a/s/2 --object-store /var/lib/arc/object-store
    arc mount -m ~/a/3 -S ~/a/s/3 --object-store /var/lib/arc/object-store
    arc mount -m ~/a/4 -S ~/a/s/4 --object-store /var/lib/arc/object-store
}

# Worktree workflow. wt-helper does the work and reports where to go via
# $WT_CD_FILE, because a subprocess cannot cd for us.
if [[ -x ~/bin/wt-helper ]]; then
    # Land in this project dir when the current directory gives no hint.
    export WT_SUBDIR=dikidi

    function wt {
        local cd_file rc dir prev
        cd_file=$(mktemp "${TMPDIR:-/tmp}/wt-cd.XXXXXX") || return 1
        prev=$PWD

        # arc refuses to unmount a worktree this shell is sitting in.
        case "$1" in rm|remove|prune) cd "$HOME" || return 1 ;; esac

        WT_PWD="$prev" WT_CD_FILE="$cd_file" ~/bin/wt-helper "$@"
        rc=$?
        dir=$(< "$cd_file")
        rm -f "$cd_file"
        if [[ -n $dir ]]; then
            cd "$dir"
        elif [[ $PWD != "$prev" ]]; then
            cd "$prev" 2>/dev/null || cd "$HOME"
        fi
        return $rc
    }

    function _wt_complete {
        local names=""
        [[ -r ~/.arc/arc-wt/state.json ]] &&
            names=$(jq -r '.entries[].name' ~/.arc/arc-wt/state.json 2>/dev/null)
        COMPREPLY=($(compgen -W "new pr go cd trunk ls rm add pull prune remount
            config help $names" -- "${COMP_WORDS[COMP_CWORD]}"))
    }
    complete -F _wt_complete wt
fi

## SSH

function colored-ssh {
    color=$1; shift
    [[ -z $color ]] || iterm-tab-colors $color
    ssh $@
    [[ -z $color ]] || iterm-tab-colors
}

## OTHER

# Shortcut for local dbs-sql
function m {
    if [[ " $@ " =~ " -q " ]] || [[ ! -t 0 ]]; then
        # no need for a tty
        ssh dev "ya tool direct sql $(printf "%q " "$@")";
    else
        ssh -t dev "ya tool direct sql $(printf "%q " "$@")";
    fi
}

function doi {
    printf "%s\0" "$@" | ssh tdev '
        [[ -f .arc/token ]] || arc token store
        [[ -f arcadia/.arcadia.root ]] || arc mount
        xargs -0 ./arcadia/direct/perl/bin/object-info | format-direct-log --colored
    '
}

# Ya tools
