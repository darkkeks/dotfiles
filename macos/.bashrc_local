## PATH

# Source brew variables
# eval "$(/opt/homebrew/bin/brew shellenv)" (5-10ms)
export HOMEBREW_PREFIX="/opt/homebrew";
export HOMEBREW_CELLAR="/opt/homebrew/Cellar";
export HOMEBREW_REPOSITORY="/opt/homebrew";
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}";
export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:";
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}";

# TODO: Отказаться или узаконить.
PATH="$HOMEBREW_PREFIX/opt/llvm/bin:$PATH"
export LDFLAGS="-L$HOMEBREW_PREFIX/opt/llvm/lib/c++"

# Add yc to PATH
[[ -d ~/yandex-cloud/bin ]] && PATH="$PATH:$HOME/yandex-cloud/bin"

## ARC

ARC_DIR=~/repo

# https://coolors.co/ffbe0b-fb5607-ff006e-8338ec-3a86ff-00ffff
ARC_COLORS=(ffbe0b fb5607 ff006e 8338ec 3a86ff 00ffff)

alias r1="cd $ARC_DIR/a1/direct; iterm-tab-colors ${ARC_COLORS[0]}"
alias r2="cd $ARC_DIR/a2/direct; iterm-tab-colors ${ARC_COLORS[1]}"
alias r3="cd $ARC_DIR/a3/direct; iterm-tab-colors ${ARC_COLORS[2]}"
alias r4="cd $ARC_DIR/a4/direct; iterm-tab-colors ${ARC_COLORS[3]}"
alias rt="cd $ARC_DIR/at/direct; iterm-tab-colors ${ARC_COLORS[4]}"
alias rb="cd $ARC_DIR/ab/direct; iterm-tab-colors ${ARC_COLORS[5]}"

function mount-all {
    arc mount -m "$ARC_DIR/a1" -S "$ARC_DIR/s1" --object-store "$ARC_DIR/object-store"
    arc mount -m "$ARC_DIR/a2" -S "$ARC_DIR/s2" --object-store "$ARC_DIR/object-store"
    arc mount -m "$ARC_DIR/a3" -S "$ARC_DIR/s3" --object-store "$ARC_DIR/object-store"
    arc mount -m "$ARC_DIR/a4" -S "$ARC_DIR/s4" --object-store "$ARC_DIR/object-store"
    arc mount -m "$ARC_DIR/at" -S "$ARC_DIR/st" --object-store "$ARC_DIR/object-store"
    arc mount -m "$ARC_DIR/ab" -S "$ARC_DIR/sb" --object-store "$ARC_DIR/object-store"
}

## SSH

function colored-ssh {
    color=$1; shift
    [[ -z $color ]] || iterm-tab-colors $color
    ssh $@
    [[ -z $color ]] || iterm-tab-colors
}

## OTHER

# Default executer config is in /etc
EXECUTER_CONF=~/.executer.conf
# WA for executer not working on macos
export PERL_LWP_SSL_VERIFY_HOSTNAME=0

# Alias for unused-code sub-issues
function unused-code { summary="$1"; shift; create-issue.py -p DIRECT-164934 -s "$summary" --do "$@"; }

# Shortcut for local dbs-sql
function m {
    if [[ " $@ " =~ " -q " ]] || [[ ! -t 0 ]]; then
        # no need for a tty
        ssh dev "ya tool direct sql $(printf "%q " "$@")";
    else
        ssh -t dev "ya tool direct sql $(printf "%q " "$@")";
    fi
}

function doi {
    printf "%s\0" "$@" | ssh tdev '
        [[ -f .arc/token ]] || arc token store
        [[ -f arcadia/.arcadia.root ]] || arc mount
        xargs -0 ./arcadia/direct/perl/bin/object-info | format-direct-log --colored
    '
}

# Ya tools
alias cs="ya-tool cs"
alias direct="ya-tool direct"
alias dnsclient="ya-tool dnsclient"
alias grut="ya-tool grut"
alias infractl="ya-tool infractl"
alias kubectl="ya-tool kubectl"
alias logbroker="ya-tool logbroker"
alias yo="ya-tool yo"
alias yp="ya-tool yp"
alias yt="ya-tool yt"
