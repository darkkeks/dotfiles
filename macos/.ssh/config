Host h1
    HostName h1.darkkeks.me
    ForwardAgent yes

Host dev
    HostName darkkeks-dev2.sas.yp-c.yandex.net
    ForwardAgent yes

Host ppcdev2

Host ppcdev* ppcback*
    ForwardAgent /Users/darkkeks/.skotty/sock/default.sock
    IdentityAgent /Users/darkkeks/.skotty/sock/default.sock

Host *.yandex.net *.yandex.ru
    ForwardAgent /Users/darkkeks/.skotty/sock/default.sock
    IdentityAgent /Users/darkkeks/.skotty/sock/default.sock
    StrictHostKeyChecking no

Host *
    AddKeysToAgent yes
