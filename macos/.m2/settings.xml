<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <profiles>
        <profile>
            <id>artifactory</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <repositories>
                <repository>
                    <id>artifactory</id>
                    <name>Nexus public repository</name>
                    <url>http://artifactory.yandex.net/artifactory/public</url>
                    <releases>
                        <enabled>true</enabled>
                        <updatePolicy>daily</updatePolicy>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>always</updatePolicy>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>artifactory</id>
                    <url>http://artifactory.yandex.net/artifactory/public</url>
                    <releases>
                        <enabled>true</enabled>
                        <updatePolicy>daily</updatePolicy>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>always</updatePolicy>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
            <properties>
                <releases-repo>http://artifactory.yandex.net/artifactory/yandex_qa_releases</releases-repo>
                <snapshots-repo>http://artifactory.yandex.net/artifactory/yandex_qa_snapshots</snapshots-repo>
            </properties>
        </profile>
        <profile>
            <id>production</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <properties>
                <post-url>aqua.yandex-team.ru</post-url>
            </properties>
        </profile>
        <profile>
           <id>testing</id>
           <activation>
               <activeByDefault>false</activeByDefault>
           </activation>
           <properties>
               <post-url>aqua-testing.yandex-team.ru</post-url>
           </properties>
        </profile>
    </profiles>

    <mirrors>
        <mirror>
            <id>artifactiry-http-unblocker</id>
            <mirrorOf>artifactory</mirrorOf>
            <name>Nexus public repository</name>
            <url>http://artifactory.yandex.net/artifactory/public</url>
            <blocked>false</blocked>
        </mirror>
    </mirrors>

    <activeProfiles>
        <activeProfile>artifactory</activeProfile>
    </activeProfiles>
</settings>
