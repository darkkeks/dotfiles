#!/usr/bin/env bash
#
# dev-bundle - prints a self-contained installer for my Arcadia shell setup.
#
# The pieces live in four different places on this machine (dotfiles scripts, a
# shell function in ~/.bashrc_local, aliases in ~/dotfiles/bare, two hooks in
# ~/.claude/settings.json), so rather than describing that layout anywhere we
# re-emit it as one script:
#
#   dev-bundle | ssh dev bash -s          # install / update on a remote box
#   dev-bundle > /tmp/dev-install.sh      # or look at it first
#
# Nothing that needs the open internet is embedded or downloaded: arc-wt and
# claude-code both come from `ya tool`, i.e. from Sandbox over the internal
# network. The only external fetch is the ya bootstrap itself, and only when
# the target box has no ya at all.

set -euo pipefail

DOT="${DEV_BUNDLE_MACOS:-$HOME/dotfiles/macos/bin}"
BARE="${DEV_BUNDLE_BARE:-$HOME/dotfiles/bare/bin}"

for f in "$DOT/wt-helper" "$DOT/claude-wt-hook" "$DOT/ya" "$DOT/ya-tool" \
         "$DOT/iterm-tab-colors" "$BARE/git_alias.sh"; do
    [[ -r $f ]] || { echo "dev-bundle: missing $f" >&2; exit 1; }
done

emit() {  # emit <dest-expr> <mode> <source-file> [prepended-line]
    printf 'write %s %s <<'"'"'__WT_EOF__'"'"'\n' "$1" "$2"
    [[ -n ${4:-} ]] && printf '%s\n' "$4"
    cat "$3"
    printf '__WT_EOF__\n\n'
}

# --- installer preamble ---------------------------------------------------

cat <<'PREAMBLE'
#!/usr/bin/env bash
# Generated by dev-bundle. Idempotent: re-run to update.
set -euo pipefail

say()  { printf '\033[1m::\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[33m!!\033[0m %s\n' "$*" >&2; }

BASE="${WT_BASE:-$HOME/a}"          # worktrees under $BASE/b, stores under $BASE/s
TRUNK="${WT_TRUNK:-$BASE/1}"        # trunk checkout
SUBDIR="${WT_SUBDIR:-dikidi}"       # project dir to land in inside a worktree

write() {  # write <dest> <mode>, content on stdin
    mkdir -p "$(dirname "$1")"
    cat > "$1.wt-tmp"
    mv "$1.wt-tmp" "$1"
    chmod "${2:-644}" "$1"
    say "wrote $1"
}

subst() {  # bake the paths into a just-written file
    sed -i.wt-bak -e "s|__BASE__|$BASE|g" -e "s|__TRUNK__|$TRUNK|g" \
                  -e "s|__SUBDIR__|$SUBDIR|g" "$1"
    rm -f "$1.wt-bak"
}

mkdir -p "$HOME/bin"
PREAMBLE

# --- payload: scripts copied verbatim -------------------------------------

# fakeya bootstrap, only when the box has no ya of its own
printf 'if command -v ya >/dev/null 2>&1; then\n'
printf '    say "ya already on PATH ($(command -v ya))"\n'
printf 'else\n'
emit '"$HOME/bin/ya"' 755 "$DOT/ya"
printf 'fi\n\n'

# arc likewise: a box that has it keeps its own, a bare one gets it from ya.
cat <<'ARCWRAPPER'
if command -v arc >/dev/null 2>&1; then
    say "arc already on PATH ($(command -v arc))"
else
    write "$HOME/bin/arc" 755 <<'__WT_EOF__'
#!/usr/bin/env bash
# The Arcadia client, via ya tool (path cached; re-resolved after `ya gc`).
set -euo pipefail
case ":$PATH:" in *":$HOME/bin:"*) ;; *) PATH="$HOME/bin:$PATH" ;; esac
cache="$HOME/.cache/arc-path"
bin=$(cat "$cache" 2>/dev/null || true)
if [[ ! -x ${bin:-} ]]; then
    bin=$(ya tool --print-path arc) || {
        echo "arc: could not get arc from ya" >&2; exit 1; }
    mkdir -p "$(dirname "$cache")"
    printf '%s\n' "$bin" > "$cache"
fi
exec "$bin" "$@"
__WT_EOF__
fi

ARCWRAPPER

emit '"$HOME/bin/wt-helper"'      755 "$DOT/wt-helper"
emit '"$HOME/bin/claude-wt-hook"' 755 "$DOT/claude-wt-hook"
emit '"$HOME/bin/ya-tool"'        755 "$DOT/ya-tool"

# The laptop copy has no shebang and leans on macOS /bin/sh being bash; give it
# one, because /bin/sh is dash on the boxes this lands on.
emit '"$HOME/bin/iterm-tab-colors"' 755 "$DOT/iterm-tab-colors" '#!/usr/bin/env bash'

# --- payload: ya-tool-backed launchers ------------------------------------
#
# ~/bin/wt is a copied Mach-O binary here and ~/bin/claude is a nix build; both
# are useless on another box, so both become wrappers that ask ya for the right
# build. Sandbox is reachable without the open internet, nix is not.

cat <<'LAUNCHERS'
write "$HOME/bin/wt" 755 <<'__WT_EOF__'
#!/usr/bin/env bash
# arc-wt, via ya tool (path cached; re-resolved after `ya gc`).
set -euo pipefail
# Claude Code hooks and other non-login shells do not read ~/.wt.bash, so ya
# has to be findable from here on our own.
case ":$PATH:" in *":$HOME/bin:"*) ;; *) PATH="$HOME/bin:$PATH" ;; esac
cache="$HOME/.cache/arc-wt-path"
bin=$(cat "$cache" 2>/dev/null || true)
if [[ ! -x ${bin:-} ]]; then
    bin=$(ya tool --print-path arc-wt) || {
        echo "wt: could not get arc-wt from ya" >&2; exit 1; }
    mkdir -p "$(dirname "$cache")"
    printf '%s\n' "$bin" > "$cache"
fi
exec "$bin" "$@"
__WT_EOF__

write "$HOME/bin/claude" 755 <<'__WT_EOF__'
#!/usr/bin/env bash
# Claude Code without nix and without the open internet.
#
# The upstream binary is mirrored into Sandbox (resource CLAUDE_CODE_BINARY,
# what `ya code claude` runs), so ya can hand us the build for this platform.
# Getting *out* is Splitty's job (the installer checks it); without that service
# nothing here can reach Anthropic from inside the network.
# Update: `claude --ya-update`.
set -euo pipefail

case ":$PATH:" in *":$HOME/bin:"*) ;; *) PATH="$HOME/bin:$PATH" ;; esac

TOOL="ya-code-claude-code"
SHIM_DIR="${HOME}/.local/bin/arc-statham-claude"
CACHE="${HOME}/.cache/claude-code-path"

resolve() {
    ya tool --force-update --print-path "$TOOL" 2>/dev/null \
        || ya tool --print-path "$TOOL"
}

if [[ "${1:-}" == "--ya-update" ]]; then
    mkdir -p "$(dirname "$CACHE")"
    resolve | tee "$CACHE"
    printf 'claude: '
    exec "$(cat "$CACHE")" --version
fi

bin=$(cat "$CACHE" 2>/dev/null || true)
if [[ ! -x ${bin:-} ]]; then
    echo "claude: fetching claude-code through ya (once)..." >&2
    bin=$(ya tool --print-path "$TOOL") || {
        echo "claude: could not get $TOOL from ya" >&2; exit 1; }
    mkdir -p "$(dirname "$CACHE")"
    printf '%s\n' "$bin" > "$CACHE"
fi

# Same hardened coreutils shims the laptop uses.
if [[ ! -x "${SHIM_DIR}/arc-statham" ]]; then
    ya tool arc-statham install --dir "${SHIM_DIR}" >&2 || true
fi

# Anything auth-shaped lives here, out of this generated file: e.g.
#   export ANTHROPIC_BASE_URL=https://api.eliza.yandex.net/raw/anthropic
#   export ANTHROPIC_AUTH_TOKEN=...
[[ -f "${HOME}/.config/claude-env.sh" ]] && source "${HOME}/.config/claude-env.sh"

exec env PATH="${SHIM_DIR}:${PATH}" "$bin" "$@"
__WT_EOF__

LAUNCHERS

# --- payload: arc-wt config -----------------------------------------------

cat <<'CONFIG'
if [[ -e $HOME/.arc/arc-wt.yaml ]]; then
    say "keeping existing ~/.arc/arc-wt.yaml"
else
    write "$HOME/.arc/arc-wt.yaml" 644 <<CONF
# arc-wt configuration, written by dev-install.

worktrees_base_path: $BASE/b
stores_base_path: $BASE/s
trunk_path: $TRUNK

# Shared across worktrees; keep it on the same disk as the stores.
object_store_path: $BASE/object-store

default_repo: arcadia
default_base: trunk
default_mode: mount-shared
CONF
fi
# $TRUNK has to exist even before it is mounted: arc-wt hands it to subprocesses
# as their cwd, and a missing cwd surfaces as a bare FileNotFoundError.
mkdir -p "$BASE/b" "$BASE/s" "$BASE/object-store" "$TRUNK"

CONFIG

# --- payload: the wt shell function ---------------------------------------

cat <<'WTBASH'
write "$HOME/.wt.bash" 644 <<'__WT_EOF__'
# The `wt` workflow. wt-helper does the work and reports where to go via
# $WT_CD_FILE, because a subprocess cannot cd for us.

case ":$PATH:" in *":$HOME/bin:"*) ;; *) PATH="$HOME/bin:$PATH" ;; esac

if [[ -x ~/bin/wt-helper ]]; then
    # Land in this project dir when the current directory gives no hint.
    export WT_SUBDIR=__SUBDIR__

    function wt {
        local cd_file rc dir prev
        cd_file=$(mktemp "${TMPDIR:-/tmp}/wt-cd.XXXXXX") || return 1
        prev=$PWD

        # arc refuses to unmount a worktree this shell is sitting in.
        case "$1" in rm|remove|prune) cd "$HOME" || return 1 ;; esac

        WT_PWD="$prev" WT_CD_FILE="$cd_file" ~/bin/wt-helper "$@"
        rc=$?
        dir=$(< "$cd_file")
        rm -f "$cd_file"
        if [[ -n $dir ]]; then
            cd "$dir"
        elif [[ $PWD != "$prev" ]]; then
            cd "$prev" 2>/dev/null || cd "$HOME"
        fi
        return $rc
    }

    function _wt_complete {
        local names=""
        [[ -r ~/.arc/arc-wt/state.json ]] &&
            names=$(jq -r '.entries[].name' ~/.arc/arc-wt/state.json 2>/dev/null)
        COMPREPLY=($(compgen -W "new pr go cd trunk ls rm add pull prune remount
            config help $names" -- "${COMP_WORDS[COMP_CWORD]}"))
    }
    complete -F _wt_complete wt
fi
__WT_EOF__

subst "$HOME/.wt.bash"

WTBASH

# --- payload: git/arc aliases ---------------------------------------------

{
    printf 'write "$HOME/.arc-aliases.bash" 644 <<'"'"'__WT_EOF__'"'"'\n'
    printf '# gst, gco, gd and friends. vcs() picks arc or git per repository.\n'
    printf '# Copied from ~/dotfiles/bare/bin/git_alias.sh.\n\n'
    cat "$BARE/git_alias.sh"
    cat <<'EXTRA'

#
# Arcadia mounts
#

# https://coolors.co/660000-ffbe0b-fb5607-ff006e-8338ec-3a86ff-00ffff
ARC_COLORS=(660000 ffbe0b fb5607 ff006e 8338ec 3a86ff 00ffff)

# r<N>: jump to a numbered mount, tinting the tab like on the laptop. The
# escape codes travel over ssh, so the colours still work from iTerm.
function _arc_go {
    local idx=$1 dir=$2
    [[ -d $dir/${WT_SUBDIR:-__SUBDIR__} ]] && dir=$dir/${WT_SUBDIR:-__SUBDIR__}
    [[ -d $dir ]] || { echo "no such mount: $dir" >&2; return 1; }
    cd "$dir" || return 1
    command -v iterm-tab-colors >/dev/null 2>&1 &&
        iterm-tab-colors "${ARC_COLORS[$idx]}"
}

alias r0='_arc_go 0 /arc'
alias r1='_arc_go 1 __TRUNK__'
alias r2='_arc_go 2 __BASE__/2'
alias r3='_arc_go 3 __BASE__/3'
alias r4='_arc_go 4 __BASE__/4'

# First thing to run on a fresh box: everything else needs a trunk.
function mount-trunk {
    mkdir -p __TRUNK__ __BASE__/s/trunk __BASE__/object-store
    arc mount -m __TRUNK__ -S __BASE__/s/trunk --object-store __BASE__/object-store
}

#
# Ya tools
#

alias aisuite="ya-tool aisuite"
alias aws="ya-tool aws"
alias cs="ya-tool cs"
alias direct="ya-tool direct"
alias dist2="ya-tool dist2"
alias dnsclient="ya-tool dnsclient"
alias grut="ya-tool grut"
alias infractl="ya-tool infractl"
alias kubectl="ya-tool kubectl"
alias logbroker="ya-tool logbroker"
alias sky="ya-tool sky"
alias tofu="ya-tool tofu"
alias tvmknife="ya-tool tvmknife"
alias yo="ya-tool yo"
alias yp="ya-tool yp"
alias yt="ya-tool yt"
EXTRA
    printf '__WT_EOF__\n\n'
}

printf 'subst "$HOME/.arc-aliases.bash"\n\n'

# --- installer tail -------------------------------------------------------

cat <<'TAIL'
# --- hook both files into the shell ---------------------------------------

for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    [[ -e $rc ]] || continue
    for f in .wt.bash .arc-aliases.bash; do
        if grep -q "$f" "$rc"; then
            say "$rc already sources ~/$f"
        else
            printf '\n[[ -f ~/%s ]] && source ~/%s\n' "$f" "$f" >> "$rc"
            say "hooked ~/$f into $rc"
        fi
    done
done

# --- claude code worktree hooks -------------------------------------------

if [[ -d $HOME/.claude ]] && command -v python3 >/dev/null 2>&1; then
    python3 - <<'__WT_EOF__'
import json, pathlib

path = pathlib.Path.home() / ".claude" / "settings.json"
data = json.loads(path.read_text()) if path.exists() else {}
hooks = data.setdefault("hooks", {})
wanted = {
    "WorktreeCreate": ("create", 600, "Creating arc worktree..."),
    "WorktreeRemove": ("remove", 300, "Removing arc worktree..."),
}
changed = False
for event, (arg, timeout, message) in wanted.items():
    cmd = f'"$HOME/bin/claude-wt-hook" {arg}'
    groups = hooks.setdefault(event, [])
    if any(h.get("command") == cmd for g in groups for h in g.get("hooks", [])):
        continue
    groups.append({"hooks": [{"type": "command", "command": cmd,
                              "timeout": timeout, "statusMessage": message}]})
    changed = True

if changed:
    if path.exists():
        path.with_suffix(".json.wt-bak").write_text(path.read_text())
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")
    print(":: patched ~/.claude/settings.json (backup: settings.json.wt-bak)")
else:
    print(":: ~/.claude/settings.json already has the worktree hooks")
__WT_EOF__
else
    say "no ~/.claude here, skipping the Claude Code worktree hooks"
fi

# --- what still has to be there -------------------------------------------

command -v python3 >/dev/null 2>&1 || warn "python3 is not on PATH — wt-helper needs it"

APT_UPDATED=0
apt_update_once() {
    (( APT_UPDATED )) && return 0
    sudo -n apt-get update -qq >&2 || return 1
    APT_UPDATED=1
}

missing=()
command -v jq  >/dev/null 2>&1 || missing+=(jq)
command -v fzf >/dev/null 2>&1 || missing+=(fzf)
if (( ${#missing[@]} )); then
    if sudo -n true 2>/dev/null && apt_update_once; then
        say "installing ${missing[*]}"
        sudo -n apt-get install -y "${missing[@]}" >&2 ||
            warn "could not install ${missing[*]}"
    else
        warn "missing ${missing[*]} (jq caches ya tool paths and feeds wt completion,"
        warn "fzf is the nicer wt picker; both are optional now, just slower/plainer)"
        warn "    sudo apt install ${missing[*]}"
    fi
fi

# --- splitty --------------------------------------------------------------
#
# Splitty is the system agent that routes AI-assistant traffic onto the
# corporate proxies; without it claude cannot reach Anthropic from inside the
# network at all. `ya code` refuses to start without it, and we need the same
# thing for the plain binary. Fresh QYP dev images ship it enabled already.
# https://docs.yandex-team.ru/devtools/ai-assistant/splitty

SPLITTY_URL="https://proxy-check.sec.yandex.net"
SPLITTY_OK="Splitty is properly configured and ready to go!"

splitty_ok() {
    local body
    if command -v curl >/dev/null 2>&1; then
        body=$(curl -fsS --max-time 10 "$SPLITTY_URL" 2>/dev/null) || return 1
    elif command -v python3 >/dev/null 2>&1; then
        body=$(python3 -c "import urllib.request; print(urllib.request.urlopen('$SPLITTY_URL', timeout=10).read().decode('utf-8', 'replace'))" 2>/dev/null) || return 1
    else
        return 1
    fi
    [[ $body == *"$SPLITTY_OK"* ]]
}

splitty_by_hand() {
    warn "    sudo apt update && sudo apt install yandex-splitty-srv"
    warn "    sudo systemctl enable --now yandex-splitty"
    warn "    curl $SPLITTY_URL"
}

if splitty_ok; then
    say "splitty ok — AI traffic goes through the corporate proxy"
elif ! command -v systemctl >/dev/null 2>&1; then
    warn "splitty is not answering and there is no systemd here — claude will not"
    warn "reach Anthropic. See https://docs.yandex-team.ru/splitty/"
elif systemctl is-active --quiet yandex-splitty 2>/dev/null; then
    warn "yandex-splitty runs, but $SPLITTY_URL does not confirm it."
    warn "Usually that means this VM's network macro has no route to"
    warn "ai-proxy.sec.yandex.net and _RTC_AI_PROXIES_NETS_ over TCP/443 —"
    warn "open it at puncher.yandex-team.ru, then restart yandex-splitty."
elif sudo -n true 2>/dev/null; then
    say "installing yandex-splitty-srv"
    if apt_update_once &&
       sudo -n apt-get install -y yandex-splitty-srv >&2 &&
       sudo -n systemctl enable --now yandex-splitty >&2; then
        splitty_ok && say "splitty ok" ||
            warn "splitty installed but the check still fails — check puncher (TCP/443)"
    else
        warn "could not install yandex-splitty-srv; by hand:"
        splitty_by_hand
    fi
else
    warn "no splitty here and sudo wants a password, so run once by hand:"
    splitty_by_hand
fi

# --- mount arc at $TRUNK --------------------------------------------------
#
# Everything else is downstream of this: wt branches worktrees off the trunk,
# r1 jumps into it, and arc-wt hands its path to subprocesses as their cwd.

ARC=$(command -v arc 2>/dev/null || true)
[[ -n $ARC ]] || ARC="$HOME/bin/arc"

# arc mints its OAuth token from an ssh key, and the keys live in skotty on the
# laptop — so this only works when the agent was forwarded into this session.
# `ssh-add -l` returns 0 only when an agent is reachable *and* holds identities,
# which is exactly the condition arc needs.
if [[ -x $ARC && ! -f $HOME/.arc/token && -z ${ARC_TOKEN:-} ]]; then
    if ssh-add -l >/dev/null 2>&1; then
        say "no arc token here; minting one from the forwarded ssh agent"
        "$ARC" token store >&2 || warn "'arc token store' failed"
    else
        warn "no arc token, and no ssh agent reachable from this session."
        warn "The keys are in skotty on the laptop, so reconnect with the agent"
        warn "forwarded and re-run this installer:"
        warn "    ForwardAgent ~/.skotty/sock/default.sock   # in ~/.ssh/config"
        warn "    ssh -A <host>                              # or just this"
        warn "Failing that, on this box: arc token store --ask"
    fi
fi

if [[ -e $TRUNK/.arcadia.root ]]; then
    say "arc already mounted at $TRUNK"
elif [[ ! -x $ARC ]]; then
    warn "no arc anywhere — cannot mount $TRUNK"
elif [[ -n $(ls -A "$TRUNK" 2>/dev/null) ]]; then
    warn "$TRUNK is not empty and not a mount — clear it, then run 'mount-trunk'"
else
    mkdir -p "$BASE/s/trunk"
    say "mounting arc at $TRUNK (first time pulls the store, give it a minute)"
    if "$ARC" mount -m "$TRUNK" -S "$BASE/s/trunk" --object-store "$BASE/object-store" >&2; then
        say "mounted: $TRUNK"
    elif [[ ! -f $HOME/.arc/token ]]; then
        warn "the mount failed for lack of a token — see the ssh agent note above,"
        warn "then run 'mount-trunk' in a new shell"
    else
        warn "mount failed — fix what arc complained about and run 'mount-trunk'"
    fi
fi

say "done — open a new shell (or 'source ~/.wt.bash ~/.arc-aliases.bash')"
say "then: r1, wt, claude"
TAIL
