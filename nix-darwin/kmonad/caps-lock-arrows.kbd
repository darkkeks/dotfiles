(defcfg
  input  (iokit-name "Apple Internal Keyboard / Trackpad")
  ;; input  (iokit-name)
  output (kext)

  ;; Reemit unhandled events
  fallthrough true

  ;; Don't allow commands
  allow-cmd false
)

(defsrc
  esc    f1     f2     f3     f4     f5     f6     f7     f8     f9     f10    f11    f12
  grv    1      2      3      4      5      6      7      8      9      0      -      =      bspc
  tab    q      w      e      r      t      y      u      i      o      p      [      ]      \
  caps   a      s      d      f      g      h      j      k      l      ;      '      ret
  lsft   z      x      c      v      b      n      m      ,      .      /      rsft   up
  fn     lctl   lalt   lmet                 spc                  rmet   ralt   left   down   rght
)

(defalias caps (layer-toggle caps))
(defalias fn (layer-toggle fn))

(deflayer qwerty
  _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  @caps  _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _      _      _      _      _      _      _
  @fn    _      _      _                    _                    _      _      _      _      _
)

(deflayer fn
  _      brdn   brup   lp     mctl   bldn   blup   prev   pp     next   mute   vold   volu
  _      _      _      _      _      _      _      _      _      _      _      _      _      del
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      _                    _                    _      _      _      _      _
)

(deflayer caps
  _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _      _      _      _      _      _      _      _
  _      prev   pp     next   _      _      _      _      _      _      pgup   _      _      _
  _      mute   vold   volu   _      _      left   down   up     rght   pgdn   _      _
  _      _      _      _      _      _      _      _      _      _      _      _      _
  _      _      _      _                    _                    _      _      _      _      _
)
